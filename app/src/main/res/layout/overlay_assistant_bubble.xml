<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/assistant_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="UseCompoundDrawables">

    <LinearLayout
        android:id="@+id/assistant_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorSurface"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ocr_language_label"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Spinner
            android:id="@+id/bubble_spinner_ocr_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="140dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_region"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/bubble_action_region" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_name_region"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/region_select_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_start"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/bubble_action_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_stop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/bubble_action_stop" />
    </LinearLayout>

    <View
        android:id="@+id/assistant_ball"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/shape_assistant_ball"
        android:contentDescription="@string/bubble_ball_content_desc" />
</LinearLayout>
